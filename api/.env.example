# Server
PORT=8787
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://astralforgeweb.onrender.com,https://astralforgeae.com,https://www.astralforgeae.com

# Public site URL (Stripe redirects)
PUBLIC_SITE_URL=https://astralforgeweb.onrender.com

# ---- NVIDIA AI (primary demo brain) ----
# Get key: https://build.nvidia.com  (NIM / integrate.api.nvidia.com)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# Azure AI Foundry / Azure OpenAI (OpenAI-compatible v1 or classic)
# Example v1: https://YOUR.openai.azure.com/openai/v1
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_AI_PROJECT_URL=
# auto | nvidia | azure
AI_PROVIDER=auto

# ---- Lead notify ----
LEAD_EMAIL=astralfconsulting@gmail.com
# FormSubmit is used if FORMSUBMIT_ENABLE=true (no backend SMTP required)
FORMSUBMIT_ENABLE=true
WHATSAPP_NOTIFY=971505804276

# Optional webhook (Make.com / n8n / Power Automate / Teams)
LEAD_WEBHOOK_URL=

# ---- Stripe payment (AED packages) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional fixed Price IDs; if empty, Checkout uses one-time price_data in AED
STRIPE_PRICE_STARTER=
STRIPE_PRICE_BUSINESS=

# Admin (simple shared secret for listing prospects — change in production)
ADMIN_API_KEY=change-me-in-azure

# Demo abuse limits
DEMO_MAX_TURNS_PER_SESSION=20
DEMO_RATE_LIMIT_PER_MIN=30
